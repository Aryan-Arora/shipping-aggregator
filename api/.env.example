SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
PORT=4000

# --- Real courier integration (Shiprocket) ---------------------------------
# Leave unset to keep running mock-only. Setting EMAIL + PASSWORD registers
# ShiprocketAdapter in the adapter registry (see src/adapters/index.ts).
# The `couriers` table has a matching `shiprocket` row seeded with
# is_active=false — flip it on in the admin panel once this is configured
# and verified against a real account.
SHIPROCKET_API_BASE_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Origin pincode used for rate/serviceability checks — see the TODO in
# ShiprocketAdapter.ts about wiring this to the seller's actual pickup
# location instead of a single global default.
SHIPROCKET_PICKUP_PINCODE=
# Shared secret checked against the `x-api-key` header on inbound webhooks.
# Confirm the real verification mechanism before going live — see
# src/adapters/support/webhookVerifiers.ts.
SHIPROCKET_WEBHOOK_SECRET=
